-
  const sourcePosts = typeof postsList !== 'undefined' ? postsList : page.posts
  const postLimit = (config.per_page === 0) ? 9999999 : config.per_page
  function toArray(collection) {
    if (!collection) return []
    if (Array.isArray(collection)) return collection
    if (typeof collection.toArray === 'function') return collection.toArray()
    return []
  }
  const renderPosts = sourcePosts && typeof sourcePosts.limit === 'function' ? sourcePosts.limit(postLimit).toArray() : toArray(sourcePosts).slice(0, postLimit)
if renderPosts.length > 0
  each post in renderPosts
    a(href=url_for(post.path)).recent-post
      object
        .recent-info
          span.categories
            if post.categories.length > 0
              each category in post.categories.data
                object
                  a(href=url_for(category.path))= category.name
            else
              span #{__('page.noCategory')}
          span.tags
            if post.tags.length > 0
              each tag in post.tags.data
                object
                  a(href=url_for(tag.path))= tag.name
            else
              span #{__('page.noTag')}
          if post.date
            time(datetime=post.date.toJSON())= date(post.date, date_format)
        h1.recent-title
          if post.sticky > 0
            span.post-sticky #{__('page.sticky')}
          = post.title
        .recent-excerpt
          if post.excerpt.length > 0
            hr
            != post.excerpt
        span.read-more #{__('page.readMore')}

.portfolio-home-root
  padding 10px 0 30px

.portfolio-hero
  display flex
  flex-direction column
  justify-content center
  min-height calc(100vh - 90px)
  padding 48px 32px
  border 1px solid var(--theme-border)
  background-color var(--theme-bg-trans1)
  box-sizing border-box

.portfolio-kicker
  display inline-block
  margin-bottom 12px
  color var(--theme-highlight)
  font-size .9em
  font-weight bold
  text-transform uppercase
  letter-spacing 0

.portfolio-hero h1
  margin 0 0 18px
  border-bottom none !important
  display block !important
  font-size 2.4em !important
  line-height 1.18

.portfolio-hero p
  max-width 760px
  margin 0
  color var(--theme-text)
  line-height 1.9

.portfolio-hero-meta
  display flex
  flex-wrap wrap
  gap 10px
  margin-top 24px

.portfolio-hero-meta span,
.project-tags span
  display inline-block
  padding 4px 9px
  color var(--theme-text-rev)
  background-color var(--theme-subcolor)
  font-size .86em
  line-height 1.4

.portfolio-section-title
  margin 34px 0 16px

.portfolio-section-title span
  display inline-block
  margin-bottom 6px
  color var(--theme-highlight)
  font-size .88em
  font-weight bold

.portfolio-section-title h2
  margin 0
  border-bottom none !important
  display block !important

.project-scroll
  display flex
  flex-direction column
  gap 18px

.project-panel
  display grid
  grid-template-columns minmax(260px, 42%) 1fr
  gap 24px
  align-items center
  min-height 360px
  padding 22px
  border 1px solid var(--theme-border)
  background-color var(--theme-bg-trans1)
  color var(--theme-text)
  text-decoration none
  box-sizing border-box
  transition background-color .2s ease, border-color .2s ease, transform .2s ease

.project-panel:hover
  border-color var(--theme-highlight)
  background-color var(--theme-bg-soft-hover)
  transform translateY(-2px)

.project-panel-media
  width 100%
  aspect-ratio 16 / 10
  overflow hidden
  border 1px solid var(--theme-border)
  background-color rgba(0, 0, 0, .18)
  box-sizing border-box

.project-panel-media img
  display block
  width 100%
  height 100%
  object-fit cover

.project-panel-copy h2
  margin 14px 0 12px
  border-bottom none !important
  display block !important
  font-size 1.35em !important
  line-height 1.32

.project-panel-copy p
  margin 0
  color var(--theme-text)
  line-height 1.82

.project-tags
  display flex
  flex-wrap wrap
  gap 8px

.project-entry
  display inline-block
  margin-top 18px
  color var(--theme-highlight)
  font-weight bold

.stack-grid
  display grid
  grid-template-columns repeat(auto-fit, minmax(220px, 1fr))
  gap 14px
  margin-top 16px

.stack-card
  min-height 130px
  padding 16px
  border 1px solid var(--theme-border)
  background-color var(--theme-bg-trans1)
  box-sizing border-box

.stack-card p
  margin 0
  color var(--theme-text)
  line-height 1.75

.stack-card .stack-card-title
  margin-bottom 8px
  color var(--theme-highlight)
  font-weight bold

.home-article-list
  display flex
  flex-direction column
  margin-top 16px
  border 1px solid var(--theme-border)
  background-color var(--theme-bg-trans1)

.home-article-row
  display grid
  grid-template-columns 110px minmax(0, 1fr) auto
  gap 16px
  align-items center
  min-height 54px
  padding 12px 16px
  border-bottom 1px solid var(--theme-border)
  color var(--theme-text)
  text-decoration none
  box-sizing border-box

.home-article-row:last-child
  border-bottom none

.home-article-row:hover
  background-color var(--theme-bg-soft-hover)

.home-article-row time
  color var(--theme-highlight)
  white-space nowrap

.home-article-title
  overflow hidden
  color var(--theme-text-light)
  font-weight bold
  text-overflow ellipsis
  white-space nowrap

.home-article-tags
  display flex
  flex-wrap wrap
  justify-content flex-end
  gap 6px

.home-article-tags span
  display inline-block
  padding 2px 7px
  color var(--theme-text-rev)
  background-color var(--theme-subcolor)
  font-size .8em

@media (max-width: 760px)
  .portfolio-hero
    min-height auto
    padding 28px 18px

  .portfolio-hero h1
    font-size 1.9em !important

  .project-panel
    grid-template-columns 1fr
    min-height auto
    padding 16px

  .project-panel-copy h2
    font-size 1.18em !important

  .home-article-row
    grid-template-columns 1fr
    gap 8px

  .home-article-title
    white-space normal

  .home-article-tags
    justify-content flex-start

#comments
  margin-top 24px
  padding 16px
  border 1px solid var(--theme-border)
  background-color var(--theme-bg-trans1)

#utterances
  min-height 120px
